rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Los mensajes no contienen datos privados. Los clientes autenticados
    // pueden leerlos, pero solo Firebase Admin puede administrarlos.
    match /appMessages/{messageId} {
      allow get, list: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // La aplicación registra si un anuncio se mostró, se cerró o abrió una sección.
    // Solo se aceptan eventos del UID autenticado y los clientes no pueden leerlos.
    match /appMessageEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'userId',
          'messageId',
          'eventType',
          'appVersionCode',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.eventType in ['SHOWN', 'DISMISSED', 'OPENED']
        && request.resource.data.appVersionCode is int
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
